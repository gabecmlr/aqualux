---
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  align?: 'left' | 'center';
  light?: boolean;
}

const { eyebrow, title, text, align = 'left', light = false } = Astro.props;
---

<div class:list={['section-heading', `section-heading--${align}`, { 'section-heading--light': light }]} data-reveal="up">
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  {text && <p class="section-heading__text">{text}</p>}
</div>
