<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

  const initialiseMotion = () => {
    const reducedMotion = prefersReducedMotion.matches;
    const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

    if (reducedMotion) {
      document.documentElement.classList.remove('motion-enabled');
      revealItems.forEach((item) => item.classList.add('is-visible'));
    } else {
      document.documentElement.classList.add('motion-enabled');

      document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((group) => {
        const children = Array.from(group.querySelectorAll<HTMLElement>(':scope > [data-reveal]'));
        children.forEach((child, index) => {
          child.style.setProperty('--reveal-delay', `${Math.min(index, 7) * 55}ms`);
        });
      });

      const revealObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
      );
      revealItems.forEach((item) => revealObserver.observe(item));

      if (finePointer.matches) {
        document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((card) => {
          card.addEventListener('pointermove', (event) => {
            const bounds = card.getBoundingClientRect();
            card.style.setProperty('--spotlight-x', `${event.clientX - bounds.left}px`);
            card.style.setProperty('--spotlight-y', `${event.clientY - bounds.top}px`);
          });
        });

        document.querySelectorAll<HTMLElement>('[data-interactive-surface]').forEach((surface) => {
          let surfaceFrame = 0;
          surface.addEventListener('pointerenter', () => surface.classList.add('is-surface-active'));
          surface.addEventListener('pointerleave', () => {
            surface.classList.remove('is-surface-active');
            surface.style.setProperty('--surface-shift-x', '0px');
            surface.style.setProperty('--surface-shift-y', '0px');
          });
          surface.addEventListener('pointermove', (event) => {
            if (surfaceFrame) cancelAnimationFrame(surfaceFrame);
            surfaceFrame = requestAnimationFrame(() => {
              const bounds = surface.getBoundingClientRect();
              const x = Math.max(0, Math.min(event.clientX - bounds.left, bounds.width));
              const y = Math.max(0, Math.min(event.clientY - bounds.top, bounds.height));
              const shiftX = ((x / bounds.width) - 0.5) * 12;
              const shiftY = ((y / bounds.height) - 0.5) * 12;
              surface.style.setProperty('--surface-x', `${x}px`);
              surface.style.setProperty('--surface-y', `${y}px`);
              surface.style.setProperty('--surface-shift-x', `${shiftX}px`);
              surface.style.setProperty('--surface-shift-y', `${shiftY}px`);
            });
          });
        });
      }
    }

    const header = document.querySelector<HTMLElement>('[data-header]');
    const navList = document.querySelector<HTMLElement>('.primary-nav ul');
    const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.primary-nav a[href*="#"]'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-section]'));
    let activeSectionId = '';
    let scrollFrame = 0;
    let scrollTween = 0;
    let scrollTargetSectionId = '';

    const updateNavIndicator = () => {
      if (!navList) return;
      const activeLink = sectionLinks.find((link) => link.getAttribute('aria-current') === 'location');
      if (!activeLink) return;
      const listBounds = navList.getBoundingClientRect();
      const linkBounds = activeLink.getBoundingClientRect();
      navList.style.setProperty('--nav-pill-x', `${linkBounds.left - listBounds.left}px`);
      navList.style.setProperty('--nav-pill-width', `${linkBounds.width}px`);
    };

    const setActiveSection = (id: string) => {
      if (!id || activeSectionId === id) return;
      activeSectionId = id;
      sectionLinks.forEach((link) => {
        const targetId = new URL(link.href).hash.slice(1);
        if (targetId === id) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      requestAnimationFrame(updateNavIndicator);
    };

    const currentSection = () => {
      if (!sections.length) return '';
      const headerHeight = header?.offsetHeight ?? 0;
      const marker = window.scrollY + headerHeight + Math.min(window.innerHeight * 0.24, 220);
      let current = sections[0];
      sections.forEach((section) => {
        if (section.offsetTop <= marker) current = section;
      });
      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4) {
        current = sections[sections.length - 1];
      }
      return current.id;
    };

    const updateScrollState = () => {
      if (header) {
        const scrollable = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
        header.dataset.scrolled = String(window.scrollY > 12);
        header.style.setProperty('--scroll-progress', String(Math.min(window.scrollY / scrollable, 1)));
      }
      setActiveSection(scrollTargetSectionId || currentSection());
      scrollFrame = 0;
    };

    const scheduleScrollUpdate = () => {
      if (scrollFrame) return;
      scrollFrame = requestAnimationFrame(updateScrollState);
    };

    const cancelScrollTween = () => {
      if (!scrollTween) return;
      cancelAnimationFrame(scrollTween);
      scrollTween = 0;
      scrollTargetSectionId = '';
    };

    const tweenTo = (targetY: number, sectionId: string) => {
      cancelScrollTween();
      scrollTargetSectionId = sectionId;
      const startY = window.scrollY;
      const distance = targetY - startY;
      if (reducedMotion || Math.abs(distance) < 2) {
        window.scrollTo(0, targetY);
        scrollTargetSectionId = '';
        updateScrollState();
        return;
      }

      const duration = Math.min(920, Math.max(500, 420 + Math.abs(distance) * 0.12));
      const startTime = performance.now();
      const easeInOutCubic = (value: number) => value < 0.5
        ? 4 * value * value * value
        : 1 - Math.pow(-2 * value + 2, 3) / 2;

      const tick = (now: number) => {
        const progress = Math.min((now - startTime) / duration, 1);
        window.scrollTo(0, startY + distance * easeInOutCubic(progress));
        if (progress < 1) scrollTween = requestAnimationFrame(tick);
        else {
          scrollTween = 0;
          scrollTargetSectionId = '';
          updateScrollState();
        }
      };
      scrollTween = requestAnimationFrame(tick);
    };

    const localAnchorLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(
      '[data-navigation] a[href*="#"], [data-mobile-actions] a[href*="#"], .footer__links a[href*="#"], .brand[href*="#"], .hero a[href^="#"]',
    ));
    localAnchorLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        const url = new URL(link.href);
        const target = url.hash ? document.getElementById(url.hash.slice(1)) : null;
        if (!target || url.pathname !== window.location.pathname) return;
        event.preventDefault();
        const headerHeight = header?.offsetHeight ?? 0;
        const targetY = Math.max(0, target.getBoundingClientRect().top + window.scrollY - headerHeight - 16);
        const sectionId = target.closest<HTMLElement>('[data-nav-section]')?.id ?? target.id;
        if (window.location.hash !== url.hash) history.pushState(null, '', url.hash);
        setActiveSection(sectionId);
        tweenTo(targetY, sectionId);
      });
    });

    ['wheel', 'touchstart'].forEach((eventName) => {
      window.addEventListener(eventName, cancelScrollTween, { passive: true });
    });
    window.addEventListener('keydown', (event) => {
      if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', 'Space'].includes(event.code)) cancelScrollTween();
    });
    window.addEventListener('scroll', scheduleScrollUpdate, { passive: true });
    window.addEventListener('resize', () => {
      scheduleScrollUpdate();
      requestAnimationFrame(updateNavIndicator);
    }, { passive: true });

    updateScrollState();
    requestAnimationFrame(updateNavIndicator);
  };

  initialiseMotion();
</script>
