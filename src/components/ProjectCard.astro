---
import Icon from './Icon.astro';
import type { Project } from '../data/site';
interface Props { project: Project; }
const { project } = Astro.props;
---

<article class="project-card" data-reveal="up" data-spotlight>
  <div class="project-card__media">
    <figure>
      {project.beforeImage ? (
        <img src={project.beforeImage} alt={`${project.title} before work`} width="640" height="480" loading="lazy" />
      ) : (
        <div class="proof-placeholder"><Icon name="spark" size={30} /><span>Real before photo</span></div>
      )}
      <figcaption>Before</figcaption>
    </figure>
    <figure>
      {project.afterImage ? (
        <img src={project.afterImage} alt={`${project.title} after work`} width="640" height="480" loading="lazy" />
      ) : (
        <div class="proof-placeholder proof-placeholder--after"><Icon name="check" size={30} /><span>Real after photo</span></div>
      )}
      <figcaption>After</figcaption>
    </figure>
  </div>
  <div class="project-card__body">
    <div><span class="demo-badge">Placeholder project</span><p class="project-card__category">{project.category}</p></div>
    <h3>{project.title}</h3>
    <p>{project.summary}</p>
    <p class="project-card__result"><Icon name="check" size={18} /><span>{project.result}</span></p>
  </div>
</article>
