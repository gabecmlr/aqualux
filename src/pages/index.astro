---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ReviewCard from '../components/ReviewCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { business, faqs, processSteps, projects, reviews, services } from '../data/site';
import electricalControlPanel from '../assets/work/electrical-control-panel.jpeg';
import electricalDistributionBoard from '../assets/work/electrical-distribution-board.jpeg';
import electricalLightingVanity from '../assets/work/electrical-lighting-vanity.jpeg';
import plumbingShowerEnclosure from '../assets/work/plumbing-shower-enclosure.jpeg';
import plumbingShowerFixture from '../assets/work/plumbing-shower-fixture.jpeg';
import plumbingVanity from '../assets/work/plumbing-vanity.jpeg';
import plumbingWaterHeater from '../assets/work/plumbing-water-heater.jpeg';
---

<BaseLayout
  title="Aqualux"
  description="Dependable electrical and plumbing services for homes, landlords and local businesses."
>
  <section class="hero anchor-section" id="home" data-nav-section>
    <div class="hero__glow hero__glow--one" aria-hidden="true"></div>
    <div class="hero__glow hero__glow--two" aria-hidden="true"></div>
    <div class="hero__swoosh" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__content" data-reveal="left">
        <p class="eyebrow eyebrow--light">Electrical + plumbing, thoughtfully handled</p>
        <h1>Water flows. Power works. <em>Life carries on.</em></h1>
        <p class="hero__lead">{business.description} One clear conversation, two essential trades.</p>
        <div class="hero__actions">
          <a class="button button--aqua" href="#quote">Request a quote <Icon name="arrow" size={19} /></a>
          <a class="text-link text-link--light" href={`tel:${business.phoneHref}`}><Icon name="phone" size={19} /> {business.phoneDisplay}</a>
        </div>
      </div>
      <div class="hero-visual hero-visual--photos" data-reveal="scale">
        <div class="hero-visual__grid" aria-hidden="true"></div>
        <div class="hero-visual__photos">
          <Image
            class="site-photo hero-visual__photo hero-visual__photo--finish"
            src={electricalControlPanel}
            alt="Detailed electrical control panel installation"
            widths={[280, 420, 620]}
            sizes="(max-width: 800px) 50vw, 240px"
            format="webp"
            quality={82}
            loading="eager"
            fetchpriority="high"
          />
          <Image
            class="site-photo hero-visual__photo hero-visual__photo--electrical"
            src={plumbingVanity}
            alt="Completed bathroom vanity with basin, mirror and storage"
            widths={[280, 420, 620]}
            sizes="(max-width: 800px) 50vw, 240px"
            format="webp"
            quality={82}
            loading="eager"
          />
        </div>
        <div class="hero-visual__label hero-visual__label--top"><Icon name="droplet" size={18} /> Precise plumbing</div>
        <div class="hero-visual__label hero-visual__label--bottom"><Icon name="bolt" size={18} /> Careful electrical</div>
      </div>
    </div>
    <div class="container trust-bar" aria-label="What to expect" data-stagger>
      <div data-reveal="up"><Icon name="shield" size={22} /><span><strong>Clear scope</strong> before work begins</span></div>
      <div data-reveal="up"><Icon name="spark" size={22} /><span><strong>Neat thinking</strong> from issue to finish</span></div>
      <div data-reveal="up"><Icon name="building" size={22} /><span><strong>Homes & businesses</strong> supported</span></div>
    </div>
  </section>

  <section class="section section--services anchor-section interactive-surface" id="services" data-nav-section data-interactive-surface>
    <div class="container">
      <SectionHeading eyebrow="Services" title="Two essential trades. One dependable standard." text="Repairs, upgrades and planned installations for homes, rental properties and local businesses." />
      <div class="service-grid service-grid--detailed" data-stagger>
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
      <div class="service-photo-grid" aria-label="Examples of Aqualux installations" data-stagger>
        <figure class="service-photo service-photo--plumbing" data-reveal="up">
          <Image
            class="site-photo"
            src={plumbingShowerFixture}
            alt="Chrome shower fixture installed against neutral wall tiles"
            widths={[320, 520, 760]}
            sizes="(max-width: 800px) 100vw, 34vw"
            format="webp"
            quality={82}
            loading="lazy"
          />
          <figcaption><Icon name="droplet" size={18} /><span><strong>Plumbing fixtures</strong> Clean, carefully fitted details.</span></figcaption>
        </figure>
        <figure class="service-photo service-photo--heating" data-reveal="up">
          <Image
            class="site-photo"
            src={plumbingWaterHeater}
            alt="Wall-mounted water heater with connected pipework"
            widths={[320, 520, 760]}
            sizes="(max-width: 800px) 100vw, 30vw"
            format="webp"
            quality={82}
            loading="lazy"
          />
          <figcaption><Icon name="pipe" size={18} /><span><strong>Water systems</strong> Practical installations for everyday use.</span></figcaption>
        </figure>
        <figure class="service-photo service-photo--electrical" data-reveal="up">
          <Image
            class="site-photo"
            src={electricalDistributionBoard}
            alt="Large electrical distribution board with organised circuits"
            widths={[320, 520, 760]}
            sizes="(max-width: 800px) 100vw, 36vw"
            format="webp"
            quality={82}
            loading="lazy"
          />
          <figcaption><Icon name="bolt" size={18} /><span><strong>Electrical systems</strong> Detailed installation and organisation.</span></figcaption>
        </figure>
      </div>
      <p class="demo-note">Service coverage shown is illustrative and must be confirmed by Aqualux before launch.</p>
    </div>
    <div class="container process-band" data-reveal="up">
      <div class="process-band__heading">
        <p class="eyebrow eyebrow--light">A clear process</p>
        <h2>From first message to agreed quote.</h2>
      </div>
      <ol class="step-cards" data-stagger>
        {processSteps.map((step) => <li data-reveal="up"><span>{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section anchor-section interactive-surface" id="work" data-nav-section data-interactive-surface>
    <div class="container">
      <SectionHeading eyebrow="Our work" title="Proof you can see. Feedback you can trust." text="Before-and-after projects and approved customer reviews will show the standard of Aqualux work in one place." />
      <div class="evidence-notice" data-reveal="up">
        <Icon name="shield" size={25} />
        <div><strong>Honest placeholders</strong><p>The entries below are layout examples, not claims of completed work. Replace every photo, fact and review with customer-approved evidence before launch.</p></div>
      </div>
      <div class="project-list" data-stagger>
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
      <div class="reviews-block" id="reviews">
        <div class="reviews-block__glow" aria-hidden="true"></div>
        <SectionHeading eyebrow="Customer reviews" title="Recommended by every Facebook reviewer." text="Recent recommendations shared publicly by Aqualux customers on Facebook." align="center" light />
        <a
          class="reviews-block__disclaimer"
          href={business.facebookReviewsUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-reveal="up"
          aria-label="View all 8 Aqualux reviews on Facebook (opens in a new tab)"
        >
          <Icon name="facebook" size={18} /> 100% recommend Aqualux across 8 public Facebook reviews.
        </a>
        <div class="review-grid" data-stagger>
          {reviews.map((review, index) => <ReviewCard review={review} featured={index === 1} />)}
        </div>
        <div class="center-action" data-reveal="up">
          <a
            class="button button--primary"
            href={business.facebookReviewsUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Leave an Aqualux review on Facebook (opens in a new tab)"
          >
            Leave a review on Facebook <Icon name="facebook" size={19} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--mist anchor-section interactive-surface" id="faqs" data-nav-section data-interactive-surface>
    <div class="container faq-grid">
      <figure class="embedded-photo faq-intro" data-reveal="scale">
        <Image
          class="site-photo embedded-photo__image"
          src={plumbingShowerEnclosure}
          alt="Completed tiled shower enclosure with glass screen"
          widths={[360, 560, 760]}
          sizes="(max-width: 800px) 100vw, 34vw"
          format="webp"
          quality={82}
          loading="lazy"
        />
        <div class="embedded-photo__content faq-intro__content">
          <SectionHeading eyebrow="FAQs" title="Useful answers before you enquire." text="Quick answers about services, quotes and coverage." light />
        </div>
        <figcaption class="embedded-photo__caption">Finished plumbing installation</figcaption>
      </figure>
      <div class="faq-list" data-stagger>
        {faqs.map((faq) => (
          <details name="aqualux-faq" data-reveal="up">
            <summary><span>{faq.question}</span><span class="faq-icon" aria-hidden="true"></span></summary>
            <div class="faq-answer"><p>{faq.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section contact-section anchor-section interactive-surface" id="contact" data-nav-section data-interactive-surface>
    <div class="container contact-grid">
      <aside class="contact-aside" aria-labelledby="contact-details-heading" data-reveal="left">
        <figure class="embedded-photo contact-aside__feature">
          <Image
            class="site-photo embedded-photo__image"
            src={electricalLightingVanity}
            alt="Bathroom vanity with backlit mirrors and pendant lighting"
            widths={[360, 560, 760]}
            sizes="(max-width: 800px) 100vw, 34vw"
            format="webp"
            quality={82}
            loading="lazy"
          />
          <div class="embedded-photo__content contact-aside__feature-content">
            <p class="eyebrow eyebrow--light">Contact Aqualux</p>
            <h2 id="contact-details-heading">Tell us about the job.</h2>
            <p>Use the quote form or contact Aqualux directly by phone, email or WhatsApp.</p>
            <a
              class="button button--whatsapp contact-whatsapp"
              href={business.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Message Aqualux on WhatsApp (opens in a new tab)"
            >
              <Icon name="phone" size={19} /> <span>Message us on WhatsApp</span>
            </a>
          </div>
          <figcaption class="embedded-photo__caption">Lighting and plumbing, neatly coordinated</figcaption>
        </figure>
        <ul class="contact-list">
          <li><div class="icon-tile"><Icon name="phone" size={23} /></div><div><span>Phone</span><a href={`tel:${business.phoneHref}`}>{business.phoneDisplay}</a></div></li>
          <li><div class="icon-tile"><Icon name="mail" size={23} /></div><div><span>Email</span><a href={`mailto:${business.email}`}>{business.email}</a></div></li>
          <li><div class="icon-tile"><Icon name="facebook" size={23} /></div><div><span>Facebook</span><a href={business.facebookUrl} target="_blank" rel="noopener noreferrer">Visit our page<span class="sr-only"> (opens in a new tab)</span></a></div></li>
          <li><div class="icon-tile"><Icon name="map" size={23} /></div><div><span>Service area</span><strong>{business.serviceArea}</strong></div></li>
        </ul>
      </aside>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
